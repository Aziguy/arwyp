---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'start' | 'center';
  id?: string;
}

const { eyebrow, title, intro, align = 'start', id } = Astro.props;
---

<header class:list={['sh', `sh--${align}`]}>
  <div class="sh__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} set:html={title} />
    {intro && <p class="sh__intro">{intro}</p>}
  </div>
  {
    Astro.slots.has('default') && (
      <div class="sh__actions">
        <slot />
      </div>
    )
  }
</header>

<style>
  .sh {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-6);
    margin-bottom: var(--sp-10);
  }

  .sh__copy {
    display: grid;
    gap: var(--sp-3);
    max-width: 720px;
  }

  .sh__intro {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--ink-2);
  }

  :global(.section--dark) .sh__intro {
    color: rgb(255 255 255 / 0.72);
  }

  .sh--center {
    justify-content: center;
    text-align: center;
  }

  .sh--center .sh__copy {
    justify-items: center;
    margin-inline: auto;
  }
</style>
