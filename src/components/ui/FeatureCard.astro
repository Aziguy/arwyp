---
import Icon from './Icon.astro';
import { url } from '@/lib/paths';

interface Props {
  icon: string;
  title: string;
  text?: string;
  href?: string;
  cta?: string;
  variant?: 'default' | 'tint' | 'dark';
  quote?: 'b';
}

const { icon, title, text, href, cta, variant = 'default', quote } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href ? url(href) : undefined} class:list={['fc', `fc--${variant}`, { 'fc--link': href }, quote && `only-${quote}`]}>
  <span class="fc__icon"><Icon name={icon} size={22} /></span>
  <h3 class="fc__title">{title} {quote && <span class="tag-b" />}</h3>
  {text && <p class="fc__text">{text}</p>}
  <slot />
  {
    href && (
      <span class="link-arrow fc__cta">
        {cta ?? 'Learn more'} <Icon name="arrow-right" />
      </span>
    )
  }
</Tag>

<style>
  .fc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-6);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--ink);
    text-decoration: none;
    transition:
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .fc--tint {
    background: var(--surface-2);
    box-shadow: none;
  }

  .fc--dark {
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: rgb(255 255 255 / 0.78);
  }

  .fc--link:hover {
    color: var(--ink);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), 0 0 0 1px var(--line-2);
  }

  .fc--dark.fc--link:hover {
    color: rgb(255 255 255 / 0.85);
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(0 216 206 / 0.4);
  }

  .fc__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--teal-50);
    color: var(--teal-700);
    margin-bottom: var(--sp-1);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .fc--dark .fc__icon {
    background: rgb(0 216 206 / 0.12);
    color: var(--teal-400);
  }

  .fc--link:hover .fc__icon {
    background: var(--navy-800);
    color: var(--teal-400);
  }

  .fc__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-lg);
  }

  .fc--dark .fc__title {
    color: #fff;
  }

  .fc__text {
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  .fc--dark .fc__text {
    color: rgb(255 255 255 / 0.7);
  }

  .fc__cta {
    margin-top: auto;
    padding-top: var(--sp-2);
  }

  .fc--dark .fc__cta {
    color: var(--teal-400);
  }
</style>
