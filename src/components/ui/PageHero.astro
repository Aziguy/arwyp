---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
  tone?: 'light' | 'dark';
}

const { eyebrow, title, subtitle, crumbs = [], tone = 'light' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['hero', `hero--${tone}`, { 'hero--split': hasAside }]}>
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} tone={tone} />}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title} />
      {subtitle && <p class="hero__sub">{subtitle}</p>}
      {
        Astro.slots.has('actions') && (
          <div class="hero__actions">
            <slot name="actions" />
          </div>
        )
      }
      <slot />
    </div>
    {
      hasAside && (
        <div class="hero__aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
    background: var(--sand-50);
    border-bottom: 1px solid var(--line);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 100% 0%, rgb(0 216 206 / 0.14), transparent 60%),
      radial-gradient(40% 60% at 0% 100%, rgb(40 54 70 / 0.06), transparent 70%);
    pointer-events: none;
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(40 54 70 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(40 54 70 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(90deg, transparent, #000 60%);
  }

  .hero--dark {
    background: var(--navy-900);
    color: rgb(255 255 255 / 0.8);
    border-bottom: 0;
  }

  .hero--dark .hero__bg {
    background:
      radial-gradient(60% 90% at 100% 0%, rgb(0 216 206 / 0.22), transparent 60%),
      radial-gradient(50% 70% at 0% 100%, rgb(0 74 94 / 0.6), transparent 70%);
  }

  .hero--dark .hero__bg::after {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
  }

  .hero--dark h1 {
    color: #fff;
  }

  .hero--dark .eyebrow {
    color: var(--teal-400);
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--sp-10);
    align-items: center;
  }

  .hero--split .hero__inner {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  }

  .hero__copy {
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
    max-width: 780px;
  }

  .hero h1 {
    font-size: clamp(2.125rem, 1.4rem + 2.8vw, 3.5rem);
  }

  .hero__sub {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 680px;
  }

  .hero--dark .hero__sub {
    color: rgb(255 255 255 / 0.75);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }

  @media (max-width: 960px) {
    .hero--split .hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
