---
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/site/Logo.astro';
import type { AppNavGroup } from '@/data/app/nav';
import { url } from '@/lib/paths';

interface Props {
  groups: AppNavGroup[];
  area: 'admin' | 'doctor' | 'portal';
  home: string;
}

const { groups, area, home } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === home ? path === url(href) : path.startsWith(url(href)));
const label = { admin: 'Back-office', doctor: 'Specialist workspace', portal: 'Patient portal' }[area];
---

<aside class="sb" id="app-sidebar" data-sidebar>
  <div class="sb__brand">
    <Logo tone="light" compact href={home} />
    <span class="sb__area">
      <strong>Arwyp</strong>
      <small>
        {
          area === 'admin' ? (
            <>
              <span class="only-a">Content management</span>
              <span class="only-b">{label}</span>
            </>
          ) : (
            label
          )
        }
      </small>
    </span>
    <button type="button" class="sb__close" data-sidebar-close aria-label="Close navigation">
      <Icon name="x" size={20} />
    </button>
  </div>

  <nav class="sb__nav" aria-label={label}>
    {
      groups.map((g) => (
        <div class:list={['sb__group', { 'only-b': g.items.every((i) => i.quote === 'b') }]}>
          {g.title && <p class="sb__title">{g.title}</p>}
          <ul role="list">
            {g.items.map((item) => (
              <li class={item.quote ? `only-${item.quote}` : undefined}>
                <a href={url(item.href)} class="sb__link" aria-current={isCurrent(item.href) ? 'page' : undefined} title={item.label}>
                  <Icon name={item.icon} size={18} />
                  <span class="sb__label">{item.label}</span>
                  {item.badge && <span class="sb__badge">{item.badge}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="sb__foot">
    <a class="sb__link" href={url('/')}>
      <Icon name="globe" size={18} />
      <span class="sb__label">View website</span>
    </a>
  </div>
</aside>
<div class="sb-scrim" data-sidebar-close hidden></div>

<style>
  .sb {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    width: var(--sb-w);
    height: 100dvh;
    background: var(--navy-950);
    color: rgb(255 255 255 / 0.72);
    transition: width 200ms var(--ease);
    z-index: 60;
  }

  .sb__brand {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 68px;
    padding: 0 var(--sp-4);
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
  }

  .sb__brand :global(.logo__mark) {
    width: 40px;
    height: 30px;
  }

  .sb__area {
    display: grid;
    min-width: 0;
    line-height: 1.2;
  }

  .sb__area strong {
    color: #fff;
    font-size: var(--fs-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sb__area small {
    font-size: var(--fs-xs);
    color: var(--teal-400);
    white-space: nowrap;
  }

  .sb__close {
    display: none;
    margin-left: auto;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    color: #fff;
  }

  .sb__nav {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-3) var(--sp-3) var(--sp-4);
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.15) transparent;
  }

  .sb__group + .sb__group {
    margin-top: var(--sp-4);
  }

  .sb__title {
    padding: 0 var(--sp-3) var(--sp-2);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
    white-space: nowrap;
  }

  .sb ul {
    display: grid;
    gap: 2px;
    margin: 0;
  }

  .sb__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 2.5rem;
    padding: 0 var(--sp-3);
    border-radius: var(--radius-md);
    color: rgb(255 255 255 / 0.72);
    font-size: var(--fs-sm);
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .sb__link :global(svg) {
    flex: none;
  }

  .sb__link:hover {
    background: rgb(255 255 255 / 0.06);
    color: #fff;
  }

  .sb__link[aria-current='page'] {
    background: rgb(0 216 206 / 0.12);
    color: #fff;
  }

  .sb__link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--teal-400);
  }

  .sb__link[aria-current='page'] :global(svg) {
    color: var(--teal-400);
  }

  .sb__badge {
    margin-left: auto;
    min-width: 1.4rem;
    padding: 0 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--teal-400);
    color: var(--navy-950);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4rem;
    text-align: center;
  }

  .sb__foot {
    padding: var(--sp-3) var(--sp-3) 84px;
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }

  @media (min-width: 1024px) {
    :global(html[data-sb='collapsed']) .sb .sb__label,
    :global(html[data-sb='collapsed']) .sb .sb__title,
    :global(html[data-sb='collapsed']) .sb .sb__area,
    :global(html[data-sb='collapsed']) .sb .sb__badge {
      display: none;
    }

    :global(html[data-sb='collapsed']) .sb .sb__link {
      justify-content: center;
      padding: 0;
    }

    :global(html[data-sb='collapsed']) .sb .sb__brand {
      justify-content: center;
      padding: 0;
    }
  }

  .sb-scrim {
    display: none;
  }

  @media (max-width: 1023px) {
    .sb {
      position: fixed;
      inset: 0 auto 0 0;
      width: min(300px, 86vw);
      transform: translateX(-100%);
      transition: transform 220ms var(--ease);
      z-index: var(--z-overlay);
    }

    :global(html[data-sb-open]) .sb {
      transform: none;
      box-shadow: var(--shadow-lg);
    }

    .sb__close {
      display: grid;
    }

    .sb__foot {
      padding-bottom: var(--sp-4);
    }

    .sb-scrim:not([hidden]) {
      display: block;
      position: fixed;
      inset: 0;
      z-index: calc(var(--z-overlay) - 1);
      background: rgb(20 28 38 / 0.45);
    }
  }
</style>
