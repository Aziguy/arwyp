---
import { url } from '@/lib/paths';

interface Props {
  tone?: 'dark' | 'light';
  compact?: boolean;
  href?: string;
}

const { tone = 'dark', compact = false, href = '/' } = Astro.props;
---

<a class:list={['logo', `logo--${tone}`, { 'logo--compact': compact }]} href={url(href)} aria-label="Arwyp Medical Centre home">
  <svg class="logo__mark" viewBox="0 0 64 48" aria-hidden="true">
    <ellipse cx="32" cy="24" rx="29.5" ry="21.5" fill="none" stroke="currentColor" stroke-width="2.2"></ellipse>
    <ellipse cx="32" cy="24" rx="25" ry="17.5" fill="none" stroke="currentColor" stroke-width="0.9" opacity="0.55"></ellipse>
    <text x="32.5" y="34.5" text-anchor="middle" fill="currentColor" class="logo__glyph">A</text>
    <path d="M16 31.5c9.5-3 21-3.2 32.5-.6" fill="none" stroke="var(--logo-accent)" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
  {
    !compact && (
      <span class="logo__text">
        <span class="logo__name">Arwyp Medical Centre</span>
        <span class="logo__sub">Private Hospital | Kempton Park</span>
      </span>
    )
  }
</a>

<style>
  .logo {
    --logo-accent: var(--teal-500);
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--navy-900);
    flex: none;
  }

  .logo--light {
    color: #fff;
    --logo-accent: var(--teal-400);
  }

  .logo:hover {
    color: inherit;
  }

  .logo--dark:hover {
    color: var(--navy-900);
  }

  .logo__mark {
    width: 52px;
    height: 39px;
  }

  .logo__glyph {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: 31px;
  }

  .logo__text {
    display: grid;
    line-height: 1.1;
  }

  .logo__name {
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .logo__sub {
    margin-top: 3px;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.68;
  }

  @media (max-width: 380px) {
    .logo__name {
      font-size: 0.9rem;
    }
    .logo__mark {
      width: 44px;
      height: 33px;
    }
  }
</style>
