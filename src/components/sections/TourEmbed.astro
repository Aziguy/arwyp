---
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/paths';
import type { Tour } from '@/config/media';

interface Props {
  tour: Tour;
  deferred?: boolean;
  class?: string;
}

const { tour, deferred = false, class: className } = Astro.props;
const poster = url(tour.poster);
---

<figure class:list={['tour-embed', className]} data-tour-embed>
  <div class="tour-embed__stage" style={`background-image: url(${poster})`}>
    {
      deferred ? (
        <button type="button" class="tour-embed__start" data-tour-start data-src={tour.src} data-title={tour.title}>
          <span class="tour-embed__play">
            <Icon name="play" size={28} />
          </span>
          <span class="tour-embed__label">Start the 3D tour</span>
        </button>
      ) : (
        <iframe src={tour.src} title={tour.title} loading="lazy" allow="fullscreen; xr-spatial-tracking; gyroscope; accelerometer" allowfullscreen />
      )
    }
  </div>
  <figcaption class="tour-embed__bar">
    <span><Icon name="move-3d" size={16} /> Drag to look around, click the floor to move</span>
    <a href={tour.src} target="_blank" rel="noopener">
      <Icon name="maximize" size={16} /> Open full screen
    </a>
  </figcaption>
</figure>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-tour-start]');
    if (!button) return;
    const frame = document.createElement('iframe');
    frame.src = button.dataset.src!;
    frame.title = button.dataset.title!;
    frame.allow = 'fullscreen; xr-spatial-tracking; gyroscope; accelerometer';
    frame.allowFullscreen = true;
    button.replaceWith(frame);
    frame.focus();
  });
</script>

<style>
  .tour-embed {
    display: grid;
    gap: var(--sp-3);
  }

  .tour-embed__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--navy-900) center / cover no-repeat;
    box-shadow: var(--shadow-lg);
  }

  .tour-embed__stage :global(iframe),
  .tour-embed__start {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .tour-embed__start {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-3);
    background: linear-gradient(180deg, rgb(20 28 38 / 0.15), rgb(20 28 38 / 0.55));
    color: #fff;
    cursor: pointer;
  }

  .tour-embed__play {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--teal-400);
    color: var(--navy-950);
    box-shadow: 0 0 0 12px rgb(0 216 206 / 0.2);
    transition: transform var(--dur) var(--ease);
  }

  .tour-embed__start:hover .tour-embed__play,
  .tour-embed__start:focus-visible .tour-embed__play {
    transform: scale(1.06);
  }

  .tour-embed__label {
    font-weight: 700;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.4);
  }

  .tour-embed__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .tour-embed__bar span,
  .tour-embed__bar a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .tour-embed__bar a {
    font-weight: 600;
    color: inherit;
  }

  @media (max-width: 520px) {
    .tour-embed__stage {
      aspect-ratio: 4 / 5;
    }
    .tour-embed__play {
      width: 4rem;
      height: 4rem;
    }
  }
</style>
