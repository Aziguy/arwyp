---
import Icon from '@/components/ui/Icon.astro';
import Visual from '@/components/ui/Visual.astro';
import { url } from '@/lib/paths';

const points = [
  { icon: 'scan', label: 'Real-time 3D imaging in theatre' },
  { icon: 'shield-check', label: 'Less radiation exposure' },
  { icon: 'target', label: 'Greater surgical accuracy' },
  { icon: 'trending-up', label: 'Smoother road to recovery' },
];
---

<section class="section section--dark oarm" aria-labelledby="oarm-title">
  <div class="container oarm__inner">
    <Visual icon="scan" tone="teal" ratio="1 / 1" label="O-Arm imaging photography" class="oarm__media" />
    <div class="oarm__copy">
      <p class="eyebrow">Advanced surgical technology</p>
      <h2 id="oarm-title">Meet the O-Arm: <span class="serif">precision surgery,</span> safer outcomes</h2>
      <p class="lead">
        Some procedures need more than a steady hand: they need a clear view. The O-Arm gives our surgical teams real-time 3D imaging during spine and
        neurosurgical procedures, so they can work with greater accuracy, less radiation exposure, and fewer surprises. For patients, that translates into
        safer surgery and a smoother road to recovery.
      </p>
      <ul class="oarm__points" role="list">
        {
          points.map((p) => (
            <li>
              <Icon name={p.icon} size={20} /> {p.label}
            </li>
          ))
        }
      </ul>
      <a class="btn btn--accent" href={url('/departments/#technology')}>Explore our technology <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .oarm {
    background:
      radial-gradient(50% 80% at 0% 50%, rgb(0 216 206 / 0.12), transparent 70%),
      var(--navy-900);
  }

  .oarm__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .oarm__copy {
    display: grid;
    gap: var(--sp-6);
    justify-items: start;
  }

  .oarm .lead {
    color: rgb(255 255 255 / 0.75);
  }

  .oarm__points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    width: 100%;
    margin: 0;
  }

  .oarm__points li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .oarm__points :global(svg) {
    flex: none;
    color: var(--teal-400);
  }

  @media (max-width: 900px) {
    .oarm__inner {
      grid-template-columns: 1fr;
    }
    .oarm__inner :global(.oarm__media) {
      max-width: 420px;
    }
  }

  @media (max-width: 520px) {
    .oarm__points {
      grid-template-columns: 1fr;
    }
  }
</style>
