---
import Icon from '@/components/ui/Icon.astro';
import Visual from '@/components/ui/Visual.astro';
import { site } from '@/config/site';
import { disciplines } from '@/data/disciplines';
import { url } from '@/lib/paths';
---

<section class="hh">
  <div class="hh__bg" aria-hidden="true"></div>
  <div class="container hh__inner">
    <div class="hh__copy">
      <p class="hh__strip"><span class="hh__dot"></span>{site.tagline}</p>
      <h1>Where <span class="serif">Compassion</span> Meets Excellence</h1>
      <p class="hh__sub">
        Arwyp Medical Centre brings together specialist doctors, modern theatres, and a 24-hour emergency department, so wherever you are in your health
        journey, you are in capable, caring hands.
      </p>
      <div class="hh__actions">
        <a class="hh__btn" href={url('/specialists/')}>
          <span class="hh__btnicon"><Icon name="search" /></span>
          <span><strong>Find a Specialist</strong><small>100+ doctors on site</small></span>
        </a>
        <a class="hh__btn" href={url('/patients/pre-admission/')}>
          <span class="hh__btnicon"><Icon name="clipboard-check" /></span>
          <span><strong>Book a Pre-Admission</strong><small>Save time at check-in</small></span>
        </a>
        <a class="hh__btn hh__btn--sos" href={site.emergency.href}>
          <span class="hh__btnicon"><Icon name="siren" /></span>
          <span><strong>Emergency? Call</strong><small>{site.emergency.display}</small></span>
        </a>
      </div>
    </div>

    <div class="hh__aside">
      <div class="only-a hh__media">
        <Visual icon="hospital" tone="navy" ratio="4 / 5" label="Hero photography supplied by Arwyp" />
        <div class="hh__float hh__float--top">
          <span class="hh__floaticon"><Icon name="shield-check" /></span>
          <span><strong>COHSASA</strong><small>Accredited hospital</small></span>
        </div>
        <div class="hh__float hh__float--bottom">
          <span class="hh__floaticon hh__floaticon--red"><Icon name="heart-pulse" /></span>
          <span><strong>24/7</strong><small>Emergency department</small></span>
        </div>
      </div>

      <form class="only-b hh__book" action={url('/specialists/')} method="get">
        <div class="hh__bookhead">
          <span class="tag-b" data-label="Online booking"></span>
          <h2>Book a specialist online</h2>
          <p>Real-time availability. Pay securely with PayFast or Peach Payments.</p>
        </div>
        <div class="field">
          <label for="hb-discipline">Speciality</label>
          <select id="hb-discipline" name="discipline" class="select">
            <option value="">All specialities</option>
            {disciplines.map((d) => <option value={d.slug}>{d.name}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="hb-q">Doctor or condition</label>
          <input id="hb-q" name="q" class="input" placeholder="e.g. knee replacement, Dr Naidoo" />
        </div>
        <button class="btn btn--accent btn--lg btn--block" type="submit"><Icon name="calendar-search" /> See availability</button>
        <ul class="hh__trust" role="list">
          <li><Icon name="lock" size={14} /> POPIA-compliant</li>
          <li><Icon name="bell-ring" size={14} /> SMS reminders</li>
          <li><Icon name="credit-card" size={14} /> Medical aid accepted</li>
        </ul>
      </form>
    </div>
  </div>
</section>

<style>
  .hh {
    position: relative;
    overflow: hidden;
    background: var(--navy-900);
    color: rgb(255 255 255 / 0.82);
  }

  .hh__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 80% at 85% 10%, rgb(0 216 206 / 0.22), transparent 60%),
      radial-gradient(60% 80% at 0% 100%, rgb(0 74 94 / 0.75), transparent 70%),
      linear-gradient(180deg, var(--navy-900), var(--navy-950));
  }

  .hh__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 70% at 70% 40%, #000, transparent);
  }

  .hh__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  .hh__copy {
    display: grid;
    gap: var(--sp-6);
    justify-items: start;
  }

  .hh__strip {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .hh__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--teal-400);
    box-shadow: 0 0 0 4px rgb(0 216 206 / 0.2);
  }

  .hh h1 {
    color: #fff;
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem);
    max-width: 14ch;
  }

  .hh h1 .serif {
    color: var(--teal-400);
  }

  .hh__sub {
    max-width: 58ch;
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: rgb(255 255 255 / 0.76);
  }

  .hh__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-3);
    width: 100%;
    margin-top: var(--sp-2);
  }

  .hh__btn {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    color: #fff;
    text-decoration: none;
    line-height: 1.3;
    transition:
      background-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .hh__btn:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(0 216 206 / 0.5);
    transform: translateY(-2px);
  }

  .hh__btn strong {
    display: block;
    font-size: var(--fs-sm);
  }

  .hh__btn small {
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.62);
  }

  .hh__btnicon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--teal-400);
    color: var(--navy-950);
  }

  .hh__btn--sos .hh__btnicon {
    background: var(--red-600);
    color: #fff;
  }

  .hh__btn--sos:hover {
    box-shadow: inset 0 0 0 1px rgb(255 120 120 / 0.6);
  }

  .hh__aside {
    position: relative;
  }

  .hh__media {
    position: relative;
    max-width: 440px;
    margin-inline: auto;
  }

  .hh__float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--navy-900);
    box-shadow: var(--shadow-lg);
    line-height: 1.25;
  }

  .hh__float strong {
    display: block;
    font-size: var(--fs-md);
  }

  .hh__float small {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }

  .hh__float--top {
    top: 12%;
    left: -12%;
  }

  .hh__float--bottom {
    bottom: 10%;
    right: -8%;
  }

  .hh__floaticon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--teal-50);
    color: var(--teal-700);
  }

  .hh__floaticon--red {
    background: var(--red-50);
    color: var(--red-600);
  }

  .hh__book {
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-8);
    border-radius: var(--radius-xl);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-lg);
  }

  .hh__bookhead {
    display: grid;
    gap: var(--sp-2);
    justify-items: start;
    margin-bottom: var(--sp-1);
  }

  .hh__bookhead h2 {
    font-size: var(--fs-xl);
  }

  .hh__bookhead p {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .hh__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2) var(--sp-4);
    margin: 0;
    padding-top: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }

  .hh__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  @media (max-width: 1100px) {
    .hh__actions {
      grid-template-columns: 1fr;
      max-width: 420px;
    }
  }

  @media (max-width: 960px) {
    .hh__inner {
      grid-template-columns: 1fr;
    }
    .hh__media {
      display: none;
    }
    .hh__float--top {
      left: 4%;
    }
    .hh__float--bottom {
      right: 4%;
    }
  }

  @media (max-width: 480px) {
    .hh__book {
      padding: var(--sp-5);
    }
  }
</style>
