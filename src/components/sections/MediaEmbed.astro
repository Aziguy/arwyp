---
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/paths';
import type { Embed } from '@/config/media';

interface Props {
  media: Embed;
  deferred?: boolean;
  tall?: boolean;
  class?: string;
}

const { media, deferred = false, tall = false, class: className } = Astro.props;
const poster = url(media.poster);
const allow = 'fullscreen; autoplay; encrypted-media; picture-in-picture; xr-spatial-tracking; gyroscope; accelerometer';
---

<figure class:list={['media-embed', { 'media-embed--tall': tall }, className]}>
  <div class="media-embed__stage" style={`background-image: url(${poster})`}>
    {
      deferred ? (
        <button type="button" class="media-embed__start" data-embed-start data-src={media.src} data-title={media.title} data-allow={allow}>
          <span class="media-embed__play">
            <Icon name="play" size={28} />
          </span>
          <span class="media-embed__label">{media.start}</span>
        </button>
      ) : (
        <iframe src={media.src} title={media.title} loading="lazy" allow={allow} allowfullscreen />
      )
    }
  </div>
  <figcaption class="media-embed__bar">
    <span><Icon name={media.hintIcon} size={16} /> {media.hint}</span>
    <a href={media.link} target="_blank" rel="noopener">
      <Icon name="external-link" size={16} /> {media.linkLabel}
    </a>
  </figcaption>
</figure>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-embed-start]');
    if (!button) return;
    const frame = document.createElement('iframe');
    frame.src = button.dataset.src!;
    frame.title = button.dataset.title!;
    frame.allow = button.dataset.allow!;
    frame.allowFullscreen = true;
    button.replaceWith(frame);
    frame.focus();
  });
</script>

<style>
  .media-embed {
    display: grid;
    gap: var(--sp-3);
  }

  .media-embed__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--navy-900) center / cover no-repeat;
    box-shadow: var(--shadow-lg);
  }

  .media-embed__stage :global(iframe),
  .media-embed__start {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .media-embed__start {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-3);
    background: linear-gradient(180deg, rgb(20 28 38 / 0.15), rgb(20 28 38 / 0.55));
    color: #fff;
    cursor: pointer;
  }

  .media-embed__play {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--teal-400);
    color: var(--navy-950);
    box-shadow: 0 0 0 12px rgb(0 216 206 / 0.2);
    transition: transform var(--dur) var(--ease);
  }

  .media-embed__start:hover .media-embed__play,
  .media-embed__start:focus-visible .media-embed__play {
    transform: scale(1.06);
  }

  .media-embed__label {
    font-weight: 700;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.4);
  }

  .media-embed__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .media-embed__bar span,
  .media-embed__bar a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .media-embed__bar a {
    font-weight: 600;
    color: inherit;
  }

  @media (max-width: 520px) {
    .media-embed--tall .media-embed__stage {
      aspect-ratio: 4 / 5;
    }
    .media-embed__play {
      width: 4rem;
      height: 4rem;
    }
  }
</style>
