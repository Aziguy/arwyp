---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/app/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import { roles, permissions } from '@/data/app/modules';

const levels = [
  { label: 'No access', icon: 'minus', tone: 'none' },
  { label: 'View', icon: 'eye', tone: 'view' },
  { label: 'Full', icon: 'check', tone: 'full' },
];
---

<AppLayout title="Roles & permissions" area="admin" gate>
  <PageHeader title="Roles & permissions" subtitle="Granular role-based access control. Changes are recorded in the audit trail.">
    <span slot="tag" class="tag-b"></span>
    <button class="btn btn--sm" data-toast-click="Permissions saved"><Icon name="check" /> Save matrix</button>
  </PageHeader>

  <section class="panel">
    <div class="rbac__scroll">
      <table class="rbac">
        <caption class="sr-only">Permissions per role</caption>
        <thead>
          <tr>
            <th scope="col">Area</th>
            {roles.map((r) => <th scope="col">{r}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            permissions.map((p) => (
              <tr>
                <th scope="row">{p.area}</th>
                {p.grants.map((g, i) => (
                  <td>
                    <button type="button" class={`lvl lvl--${levels[g].tone}`} aria-label={`${p.area}, ${roles[i]}: ${levels[g].label}`} data-level={g}>
                      <Icon name={levels[g].icon} size={14} />
                      <span>{levels[g].label}</span>
                    </button>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="rbac__hint">Click a cell to cycle between No access, View and Full.</p>
  </section>
</AppLayout>

<script>
  const labels = ['No access', 'View', 'Full'];
  const tones = ['none', 'view', 'full'];
  const icons = ['<path d="M5 12h14"/>', '<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>', '<path d="M20 6 9 17l-5-5"/>'];
  document.querySelectorAll<HTMLButtonElement>('.lvl').forEach((btn) =>
    btn.addEventListener('click', () => {
      const next = (Number(btn.dataset.level) + 1) % 3;
      btn.dataset.level = String(next);
      btn.className = `lvl lvl--${tones[next]}`;
      btn.querySelector('span')!.textContent = labels[next];
      btn.querySelector('svg')!.innerHTML = `<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">${icons[next]}</g>`;
      btn.setAttribute('aria-label', btn.getAttribute('aria-label')!.replace(/[^:]+$/, ` ${labels[next]}`));
    }),
  );
</script>

<style>
  .rbac__scroll {
    position: relative;
    overflow-x: auto;
  }

  .rbac {
    width: 100%;
    min-width: 760px;
    font-size: var(--fs-sm);
  }

  .rbac th,
  .rbac td {
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }

  .rbac thead th {
    background: var(--surface-2);
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .rbac th[scope='row'],
  .rbac thead th:first-child {
    padding-left: var(--sp-6);
    text-align: left;
    font-weight: 600;
    color: var(--navy-900);
  }

  .lvl {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 100px;
    justify-content: center;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
    transition: background-color var(--dur) var(--ease);
  }

  .lvl--none {
    background: var(--surface-3);
    color: var(--ink-3);
  }

  .lvl--view {
    background: #e8f1fc;
    color: #1c5cab;
  }

  .lvl--full {
    background: var(--green-50);
    color: #0d5c35;
  }

  .rbac__hint {
    padding: var(--sp-4) var(--sp-6);
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
</style>
