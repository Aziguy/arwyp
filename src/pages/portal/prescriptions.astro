---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/app/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import { prescriptions } from '@/data/app/portal';
import { badgeClass } from '@/lib/app/status';
import { longDate } from '@/lib/format';
---

<AppLayout title="Prescriptions" area="portal">
  <PageHeader title="Prescriptions" subtitle="View and download prescriptions, request repeats and collect at the Arwyp Retail Pharmacy." />

  <ul class="rx" role="list">
    {
      prescriptions.map((p) => (
        <li class="panel rx__item">
          <span class="icon-dot rx__icon">
            <Icon name="pill" size={20} />
          </span>
          <div class="rx__main">
            <p class="rx__name">
              {p.name} <span class={badgeClass(p.status)}>{p.status}</span>
            </p>
            <p class="rx__dose">{p.dose}</p>
            <p class="rx__meta">
              {p.prescriber} &middot; issued {longDate(p.issued)} &middot; {p.repeats} repeat{p.repeats === 1 ? '' : 's'} left
            </p>
          </div>
          <div class="rx__actions">
            {p.status === 'Active' && (
              <button class="btn btn--accent btn--sm" data-toast-click="Repeat requested, ready for collection tomorrow">
                <Icon name="refresh-cw" /> Request repeat
              </button>
            )}
            <button class="icon-btn" aria-label={`Download ${p.name}`} data-toast-click="Prescription PDF downloaded">
              <Icon name="download" size={18} />
            </button>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="secure-note rx__note"><Icon name="store" size={14} /> Retail Pharmacy open 06h00 - 22h00 daily, including public holidays.</p>
</AppLayout>

<style>
  .rx {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
  }

  .rx__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-5);
  }

  .rx__icon {
    width: 3rem;
    height: 3rem;
  }

  .rx__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 700;
    color: var(--navy-900);
  }

  .rx__dose {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .rx__meta {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }

  .rx__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .rx__note {
    margin-top: var(--sp-6);
  }

  @media (max-width: 640px) {
    .rx__item {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .rx__actions {
      grid-column: 1 / -1;
      justify-content: flex-end;
    }
  }
</style>
