---
import AppLayout from '@/layouts/AppLayout.astro';
import PageHeader from '@/components/app/PageHeader.astro';
import Avatar from '@/components/ui/Avatar.astro';
import Icon from '@/components/ui/Icon.astro';
import { inbox, thread, patient } from '@/data/app/portal';
---

<AppLayout title="Messages" area="portal">
  <PageHeader title="Secure messages" subtitle="Encrypted messaging with your specialists' rooms. No phone tag, full history retained." />

  <section class="panel chat">
    <aside class="chat__list" aria-label="Conversations">
      <ul role="list">
        {
          inbox.map((c, i) => (
            <li>
              <button type="button" class:list={['chat__conv', { 'is-active': i === 0 }]}>
                <Avatar name={c.with} size={40} />
                <span class="chat__meta">
                  <span class="chat__top">
                    <strong>{c.with}</strong>
                    <small>{c.at}</small>
                  </span>
                  <span class="chat__last">{c.last}</span>
                </span>
                {c.unread > 0 && <span class="chat__unread">{c.unread}</span>}
              </button>
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="chat__thread">
      <header class="chat__head">
        <Avatar name={thread.with} size={36} />
        <span>
          <strong>{thread.with}</strong>
          <small><Icon name="lock" size={12} /> End-to-end encrypted</small>
        </span>
      </header>
      <ol class="chat__msgs" data-msgs>
        {
          thread.messages.map((m) => (
            <li class:list={['msg', m.from === 'me' ? 'msg--me' : 'msg--them']}>
              <p>{m.text}</p>
              <small>{m.at}</small>
            </li>
          ))
        }
      </ol>
      <form class="chat__compose" data-compose>
        <button type="button" class="icon-btn" aria-label="Attach file"><Icon name="paperclip" size={18} /></button>
        <label class="sr-only" for="msg-input">Message</label>
        <input id="msg-input" class="input" placeholder={`Write to ${thread.with}...`} autocomplete="off" />
        <button type="submit" class="btn btn--sm"><Icon name="send" /> <span class="chat__send">Send</span></button>
      </form>
    </div>
  </section>
  <p class="sr-only">Signed in as {patient.name}</p>
</AppLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-compose]');
  const list = document.querySelector<HTMLOListElement>('[data-msgs]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector('input')!;
    const text = input.value.trim();
    if (!text || !list) return;
    const li = document.createElement('li');
    li.className = 'msg msg--me';
    const p = document.createElement('p');
    p.textContent = text;
    const small = document.createElement('small');
    small.textContent = 'Just now';
    li.append(p, small);
    list.append(li);
    input.value = '';
    list.scrollTop = list.scrollHeight;
  });
</script>

<style>
  .chat {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    height: min(680px, calc(100dvh - 260px));
    min-height: 460px;
    overflow: hidden;
  }

  .chat__list {
    border-right: 1px solid var(--line);
    overflow-y: auto;
  }

  .chat__list ul {
    margin: 0;
  }

  .chat__conv {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    padding: var(--sp-4);
    border-bottom: 1px solid var(--line);
    text-align: left;
    transition: background-color var(--dur) var(--ease);
  }

  .chat__conv:hover,
  .chat__conv.is-active {
    background: var(--surface-2);
  }

  .chat__conv.is-active {
    box-shadow: inset 3px 0 0 var(--teal-600);
  }

  .chat__meta {
    flex: 1;
    min-width: 0;
    display: grid;
    line-height: 1.35;
  }

  .chat__top {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .chat__top strong {
    font-size: var(--fs-sm);
    color: var(--navy-900);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat__top small {
    flex: none;
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }

  .chat__last {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat__unread {
    flex: none;
    min-width: 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--teal-600);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.25rem;
    text-align: center;
  }

  .chat__thread {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .chat__head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--line);
    line-height: 1.3;
  }

  .chat__head strong {
    display: block;
    font-size: var(--fs-sm);
    color: var(--navy-900);
  }

  .chat__head small {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-xs);
    color: #006300;
  }

  .chat__msgs {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin: 0;
    padding: var(--sp-5);
    overflow-y: auto;
    list-style: none;
    background: var(--surface-2);
  }

  .msg {
    display: grid;
    gap: 2px;
    max-width: min(76%, 520px);
  }

  .msg p {
    padding: var(--sp-3) var(--sp-4);
    border-radius: 16px;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .msg small {
    font-size: 0.6875rem;
    color: var(--ink-3);
  }

  .msg--them p {
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
    border-bottom-left-radius: 4px;
    color: var(--ink);
  }

  .msg--me {
    align-self: flex-end;
    justify-items: end;
  }

  .msg--me p {
    background: var(--navy-800);
    border-bottom-right-radius: 4px;
    color: #fff;
  }

  .chat__compose {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--line);
  }

  .chat__compose .input {
    flex: 1;
    border-radius: var(--radius-pill);
  }

  @media (max-width: 860px) {
    .chat {
      grid-template-columns: 1fr;
      height: auto;
    }
    .chat__list {
      display: none;
    }
    .chat__msgs {
      min-height: 360px;
    }
  }

  @media (max-width: 480px) {
    .chat__send {
      display: none;
    }
  }
</style>
