---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import EmptyResults from '@/components/ui/EmptyResults.astro';
import Icon from '@/components/ui/Icon.astro';
import ResultsBar from '@/components/listing/ResultsBar.astro';
import Pager from '@/components/listing/Pager.astro';
import ApplyDialog from '@/components/sections/ApplyDialog.astro';
import { vacancies, careerDepartments, vacancySlug } from '@/data/careers';
import { shortDate } from '@/lib/format';
import { url } from '@/lib/paths';

const why = [
  { icon: 'shield-check', title: '40 years of stability', text: 'A well-established, accredited private hospital.' },
  { icon: 'git-branch', title: 'Room to grow', text: 'Multi-disciplinary teams with room to specialise and grow.' },
  { icon: 'cpu', title: 'Modern facilities', text: 'Modern equipment, including advanced surgical technology.' },
  { icon: 'heart-handshake', title: 'A caring culture', text: 'Built on the same compassion we ask staff to show patients.' },
];
const types = ['Full-time', 'Part-time', 'Locum'];
---

<SiteLayout title="Careers" description="Build a career that actually helps people. Current nursing, clinical, allied health, administration and management vacancies at Arwyp Medical Centre, Kempton Park.">
  <PageHero
    eyebrow="Careers"
    title="Build a career that <span class='serif'>actually helps</span> people."
    subtitle="Join a team that's been part of the Kempton Park community for 40 years and counting."
    crumbs={[{ label: 'Careers' }]}
  >
    <div slot="actions" class="cluster">
      <a class="btn btn--accent" href="#openings"><Icon name="briefcase" /> View current openings</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Why work at Arwyp" title="A place to do your best work" />
      <div class="grid" style="--grid-min: 240px">
        {why.map((w) => <FeatureCard {...w} variant="tint" />)}
      </div>
    </div>
  </section>

  <section class="section section--tint" id="openings" data-listing data-page-size="6">
    <div class="container">
      <div class="filterbar">
        <div>
          <h2 class="filterbar__title">Current Openings</h2>
          <p class="muted">Filter by department and employment type.</p>
        </div>
        <label class="search-field">
          <Icon name="search" size={18} />
          <span class="sr-only">Search roles</span>
          <input class="input" type="search" placeholder="Search roles" data-search />
        </label>
      </div>
      <div class="cfilters">
        <div class="chips" role="toolbar" aria-label="Filter by department">
          <button type="button" class="chip" data-facet="department" data-value="">All departments</button>
          {
            careerDepartments.map((d) => (
              <button type="button" class="chip" data-facet="department" data-value={d}>
                {d} <span class="count">{vacancies.filter((v) => v.department === d).length}</span>
              </button>
            ))
          }
        </div>
        <label>
          <span class="sr-only">Employment type</span>
          <select class="select select--sm" data-facet-select="type">
            <option value="">All types</option>
            {types.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
      </div>

      <ResultsBar
        total={vacancies.length}
        noun="positions"
        sorts={[
          { value: 'closes:asc', label: 'Closing soonest' },
          { value: 'posted:desc', label: 'Newest first' },
          { value: 'title:asc', label: 'Title A-Z' },
        ]}
      />

      <ul class="jobs" role="list" data-items>
        {
          vacancies.map((v) => (
            <li
              class="job"
              data-item
              data-department={v.department}
              data-type={v.type}
              data-sort-closes={v.closes}
              data-sort-posted={v.posted}
              data-sort-title={v.title}
              data-text={`${v.title} ${v.unit} ${v.summary} ${v.ref}`}
            >
              <div class="job__main">
                <h3>
                  <a href={url(`/careers/${vacancySlug(v)}/`)}>{v.title}</a>
                </h3>
                <p>{v.summary}</p>
                <ul class="job__meta" role="list">
                  <li>
                    <Icon name="building-2" size={14} /> {v.department}
                  </li>
                  <li>
                    <Icon name="map-pin" size={14} /> {v.unit}
                  </li>
                  <li>
                    <Icon name="clock" size={14} /> {v.type}
                  </li>
                  <li>
                    <Icon name="calendar" size={14} /> Closes {shortDate(v.closes)}
                  </li>
                </ul>
              </div>
              <div class="job__cta">
                <span class="job__ref">Ref {v.ref}</span>
                <a class="btn btn--outline" href={url(`/careers/${vacancySlug(v)}/`)}>
                  View role
                </a>
                <a class="btn only-a" href={`mailto:careers@arwyp.example?subject=${encodeURIComponent(`${v.ref} ${v.title}`)}`}>
                  Apply <Icon name="arrow-right" />
                </a>
                <button type="button" class="btn btn--accent only-b" data-apply={v.ref} data-title={v.title}>
                  Apply online
                </button>
              </div>
            </li>
          ))
        }
      </ul>
      <EmptyResults text="No openings match your filters." />
      <Pager label="Vacancies pagination" />
    </div>
  </section>

  <ApplyDialog />

  <CtaBand
    eyebrow="Grow your career with us"
    title="Start or advance a healthcare career"
    text="Looking to start or advance a healthcare career rather than apply directly? Our Training Institute offers accredited programmes for aspiring healthcare professionals."
  >
    <a class="btn btn--accent btn--lg" href={url('/training/')}>Explore the Training Institute <Icon name="arrow-right" /></a>
  </CtaBand>
</SiteLayout>

<script>
  import '@/scripts/listing';
</script>

<style>
  .cfilters {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-3);
  }

  .cfilters .chips {
    margin-bottom: var(--sp-6);
  }

  .jobs {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
  }

  .job {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: var(--sp-5) var(--sp-6);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
    transition: box-shadow var(--dur) var(--ease);
  }

  .job:hover {
    box-shadow: var(--shadow-md), 0 0 0 1px var(--line-2);
  }

  .job__main {
    display: grid;
    gap: var(--sp-2);
    flex: 1 1 420px;
  }

  .job h3 {
    font-size: var(--fs-lg);
  }

  .job h3 a {
    color: inherit;
    text-decoration: none;
  }

  .job h3 a:hover {
    color: var(--teal-700);
  }

  .job__main > p {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .job__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-3);
  }

  .job__meta li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .job__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }

  .job__ref {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
</style>
