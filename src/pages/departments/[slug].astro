---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import SpecialistCard from '@/components/specialists/SpecialistCard.astro';
import { departments, departmentSpecialists, type Department } from '@/data/departments';
import { url } from '@/lib/paths';
import { clinicSchema } from '@/lib/schema';

export function getStaticPaths() {
  return departments.map((d) => ({ params: { slug: d.slug }, props: { department: d } }));
}

interface Props {
  department: Department;
}

const { department: d } = Astro.props;
const team = departmentSpecialists(d);
const [lead, ...others] = team;
const others3 = departments.filter((x) => x.slug !== d.slug).slice(0, 4);
---

<SiteLayout title={`${d.name} in Kempton Park`} description={`${d.tagline} ${d.summary}`} schema={clinicSchema(d)}>
  <PageHero
    tone="dark"
    eyebrow="Specialised Department"
    title={d.name}
    subtitle={d.tagline}
    crumbs={[{ label: 'Specialised Departments', href: '/departments/' }, { label: d.name }]}
  >
    <div slot="actions" class="cluster">
      <a class="btn btn--accent" href="#team"><Icon name="users" /> Meet the team</a>
      <a class="btn btn--outline-light only-b" href={url('/gp-referral/')}><Icon name="send" /> Refer a patient</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container dd">
      <div class="stack" style="--stack: var(--sp-6)">
        <p class="lead">{d.summary}</p>
        {
          d.highlight && (
            <p class="dd__highlight">
              <Icon name="award" /> {d.highlight}
            </p>
          )
        }
        <h2 class="dd__h">Focus areas</h2>
        <ul class="list-check dd__focus">
          {d.focus.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <aside class="dd__aside">
        {
          lead && (
            <div class="dd__lead">
              <p class="eyebrow">Lead specialist</p>
              <SpecialistCard specialist={lead} />
            </div>
          )
        }
        {
          d.referrers && (
            <div class="dd__ref">
              <p class="eyebrow">For referring specialists</p>
              <p>{d.referrers}</p>
              <a class="link-arrow only-b" href={url('/gp-referral/')}>
                Refer online <Icon name="arrow-right" />
              </a>
              <a class="link-arrow only-a" href={url('/contact/')}>
                Contact the department <Icon name="arrow-right" />
              </a>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section section--tint" id="team">
        <div class="container">
          <SectionHeader eyebrow="Specialists" title={`Our ${d.name.split(' (')[0]} team`}>
            <a class="btn btn--outline" href={url(`/specialists/?discipline=${d.disciplines[0]}`)}>
              View in directory <Icon name="arrow-right" />
            </a>
          </SectionHeader>
          <div class="grid" style="--grid-min: 280px">
            {others.map((s) => (
              <SpecialistCard specialist={s} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Explore" title="Other specialised departments" />
      <ul class="more" role="list">
        {
          others3.map((o) => (
            <li>
              <a href={url(`/departments/${o.slug}/`)}>
                <Icon name={o.icon} />
                <span>{o.name}</span>
                <Icon name="arrow-up-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .dd {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .dd__highlight {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--radius-md);
    background: var(--amber-50);
    color: #5c3f00;
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .dd__highlight :global(svg) {
    flex: none;
    color: #a26d00;
  }

  .dd__h {
    font-size: var(--fs-2xl);
  }

  .dd__aside {
    position: sticky;
    top: calc(var(--header-h) + var(--sp-6));
    display: grid;
    gap: var(--sp-6);
  }

  .dd__lead,
  .dd__ref {
    display: grid;
    gap: var(--sp-3);
  }

  .dd__ref {
    padding: var(--sp-6);
    border-radius: var(--radius-lg);
    background: var(--teal-50);
    box-shadow: inset 0 0 0 1px var(--teal-100);
  }

  .dd__ref p:not(.eyebrow) {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-4);
    margin: 0;
  }

  .more a {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-5);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--navy-900);
    font-weight: 650;
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }

  .more a:hover {
    background: var(--surface-2);
    color: var(--navy-950);
  }

  .more span {
    flex: 1;
  }

  .more :global(svg:first-child) {
    color: var(--teal-700);
  }

  @media (max-width: 960px) {
    .dd {
      grid-template-columns: 1fr;
    }
    .dd__aside {
      position: static;
    }
    .more {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .more {
      grid-template-columns: 1fr;
    }
  }
</style>
