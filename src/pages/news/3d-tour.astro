---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import MediaEmbed from '@/components/sections/MediaEmbed.astro';
import { maternityTour, hospitalFilm } from '@/config/media';
import { videoSchema } from '@/lib/schema';
---

<SiteLayout
  title="3D Maternity Tour"
  description="Walk through our maternity facilities before you ever set foot inside, then watch our hospital film of the wards, theatres and teams at Arwyp."
  schemaB={videoSchema(hospitalFilm)}
>
  <PageHero
    eyebrow="Media & News"
    title="Take a 3D Tour of Our <span class='serif'>Maternity Ward</span>"
    subtitle="Bringing a baby into the world is daunting enough without wondering what the ward will look like. Walk through our maternity facilities from wherever you are."
    crumbs={[{ label: 'Media & News', href: '/news/' }, { label: '3D Tour' }]}
  />

  <section class="section">
    <div class="container">
      <MediaEmbed media={maternityTour} tall />
    </div>
  </section>

  <section class="section section--tint only-b" id="virtual-tour">
    <div class="container vt">
      <div class="vt__head">
        <span class="tag-b" data-label="360° Virtual Hospital Tour"></span>
        <h2>Walk through the <span class="serif">whole hospital</span></h2>
        <p class="lead">From emergency and theatres to the wards and maternity unit: meet the teams and see the spaces before admission, to arrive calm and confident.</p>
      </div>
      <MediaEmbed media={hospitalFilm} deferred />
    </div>
  </section>
</SiteLayout>

<style>
  .vt {
    display: grid;
    gap: var(--sp-6);
    max-width: 1040px;
  }

  .vt__head {
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
    max-width: 720px;
  }
</style>
