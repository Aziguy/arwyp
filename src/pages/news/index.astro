---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import NewsCard from '@/components/sections/NewsCard.astro';
import EmptyResults from '@/components/ui/EmptyResults.astro';
import Icon from '@/components/ui/Icon.astro';
import TourEmbed from '@/components/sections/TourEmbed.astro';
import { maternityTour } from '@/config/media';
import { articles, articleCategories } from '@/data/news';
import ResultsBar from '@/components/listing/ResultsBar.astro';
import Pager from '@/components/listing/Pager.astro';
import { url } from '@/lib/paths';
import { itemListSchema } from '@/lib/schema';

---

<SiteLayout
  title="Media & News"
  description="Health insights, hospital news and community stories from Arwyp Medical Centre, plus a 3D tour of our maternity ward in Kempton Park."
  schema={itemListSchema('Latest news and health insights', articles.map((a) => `/news/${a.slug}/`))}
>
  <PageHero
    eyebrow="Media & News"
    title="News, insights, and a <span class='serif'>look inside</span> Arwyp."
    subtitle="Health advice worth reading, hospital news worth knowing, and a virtual walk-through of our facilities, all in one place."
    crumbs={[{ label: 'Media & News' }]}
  />

  <section class="section" data-listing data-page-size="6">
    <div class="container">
      <div class="filterbar">
        <div>
          <h2 class="filterbar__title">Latest News & Health Insights</h2>
          <p class="muted">Health advice, hospital news and stories from our community.</p>
        </div>
        <label class="search-field">
          <Icon name="search" size={18} />
          <span class="sr-only">Search articles</span>
          <input class="input" type="search" placeholder="Search articles" data-search />
        </label>
      </div>
      <div class="chips" role="toolbar" aria-label="Filter by category">
        <button type="button" class="chip" data-facet="category" data-value="">All</button>
        {
          articleCategories.map((c) => (
            <button type="button" class="chip" data-facet="category" data-value={c}>
              {c}
            </button>
          ))
        }
      </div>

      <ResultsBar
        total={articles.length}
        noun="articles"
        sorts={[
          { value: 'date:desc', label: 'Newest first' },
          { value: 'date:asc', label: 'Oldest first' },
          { value: 'title:asc', label: 'Title A-Z' },
        ]}
      />
      <div class="feed" data-items>
        {
          articles.map((a) => (
            <div data-item data-category={a.category} data-sort-date={a.date} data-sort-title={a.title} data-text={`${a.title} ${a.excerpt} ${a.author}`}>
              <NewsCard article={a} />
            </div>
          ))
        }
      </div>
      <EmptyResults text="No articles match your search." />
      <Pager label="Articles pagination" />
    </div>
  </section>

  <section class="section section--dark">
    <div class="container tour">
      <TourEmbed tour={maternityTour} deferred />
      <div class="stack" style="--stack: var(--sp-5)">
        <p class="eyebrow">3D tour</p>
        <h2>Take a 3D Tour of Our <span class="serif">Maternity Ward</span></h2>
        <p class="lead">
          Bringing a baby into the world is daunting enough without wondering what the ward will look like. Walk through our maternity facilities from wherever you
          are, before you ever set foot inside: a calm, informed way to prepare for the big day.
        </p>
        <a class="btn btn--accent" href={url('/news/3d-tour/')}>Visit the tour page <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import '@/scripts/listing';
</script>

<style>
  .feed {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-6);
  }

  .feed > [data-lead] {
    grid-column: span 2;
    grid-row: span 2;
  }

  .feed > [data-lead] :global(.visual) {
    aspect-ratio: 16 / 10;
  }

  .feed > [data-lead] :global(h3) {
    font-size: var(--fs-xl);
  }

  .tour {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .tour .lead {
    color: rgb(255 255 255 / 0.75);
  }

  .tour :global(.tour-embed__bar) {
    color: rgb(255 255 255 / 0.75);
  }

  @media (max-width: 1024px) {
    .feed {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .feed > [data-lead] {
      grid-row: auto;
    }
  }

  @media (max-width: 860px) {
    .tour {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .feed {
      grid-template-columns: 1fr;
    }
    .feed > [data-lead] {
      grid-column: auto;
    }
  }
</style>
