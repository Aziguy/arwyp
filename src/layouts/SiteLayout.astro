---
import BaseLayout from './BaseLayout.astro';
import AlertBanner from '@/components/site/AlertBanner.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import type { SeoProps } from '@/components/seo/Seo.astro';
import { organizationSchema, websiteSchema } from '@/lib/schema';

type Props = SeoProps;

const { schema, ...props } = Astro.props;
const graph = [organizationSchema(), websiteSchema(), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<BaseLayout {...props} schema={graph}>
  <AlertBanner />
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
