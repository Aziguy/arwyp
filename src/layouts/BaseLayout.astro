---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@/styles/global.css';
import QuoteSwitcher from '@/components/site/QuoteSwitcher.astro';
import Seo, { type SeoProps } from '@/components/seo/Seo.astro';
import { DEFAULT_QUOTE, QUOTE_STORAGE_KEY } from '@/config/quotes';
import { url } from '@/lib/paths';

interface Props extends SeoProps {
  bodyClass?: string;
}

const { bodyClass, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en-ZA" data-quote={DEFAULT_QUOTE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...seoProps} />
    <meta name="theme-color" content="#283646" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <script is:inline define:vars={{ key: QUOTE_STORAGE_KEY, fallback: DEFAULT_QUOTE }}>
      (function () {
        var q = new URLSearchParams(location.search).get('quote');
        try {
          q = q || localStorage.getItem(key);
        } catch (e) {}
        document.documentElement.dataset.quote = q === 'a' || q === 'b' ? q : fallback;
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <QuoteSwitcher />
    <script>
      import '@/scripts/quote';
      import '@/scripts/forms';
    </script>
  </body>
</html>
