---
import '@/styles/app.css';
import BaseLayout from './BaseLayout.astro';
import Logo from '@/components/site/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/paths';

interface Props {
  title: string;
  heading: string;
  intro: string;
  variant?: 'staff' | 'patient';
}

const { title, heading, intro, variant = 'staff' } = Astro.props;
const points =
  variant === 'staff'
    ? [
        { icon: 'shield-check', text: 'POPIA-compliant, AES-256 encrypted' },
        { icon: 'scroll-text', text: 'Every action recorded in the audit trail' },
        { icon: 'key-round', text: 'Role-based access for every team' },
      ]
    : [
        { icon: 'calendar-check', text: 'Book, reschedule and pay online' },
        { icon: 'file-heart', text: 'Results, invoices and prescriptions' },
        { icon: 'smartphone', text: 'Install it on your phone like an app' },
      ];
---

<BaseLayout title={title} bodyClass="app-body">
  <main id="main" class="auth">
    <section class="auth__panel">
      <div class="auth__top">
        <Logo />
        <a class="btn btn--ghost btn--sm" href={url('/')}><Icon name="arrow-left" /> Website</a>
      </div>
      <div class="auth__card">
        <h1>{heading}</h1>
        <p class="auth__intro">{intro}</p>
        <slot />
      </div>
      <p class="auth__legal">Demo template. Any credentials work. No data leaves your browser.</p>
    </section>
    <aside class="auth__aside" aria-hidden="true">
      <div class="auth__glow"></div>
      <div class="auth__copy">
        <p class="eyebrow">Arwyp Medical Centre</p>
        <p class="auth__quote">
          {variant === 'staff' ? 'One platform, one login, one dashboard.' : 'Your care, in your pocket.'}
        </p>
        <ul role="list">
          {
            points.map((p) => (
              <li>
                <Icon name={p.icon} size={18} /> {p.text}
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </main>
</BaseLayout>

<style>
  .auth {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 100dvh;
    background: var(--surface);
  }

  .auth__panel {
    display: flex;
    flex-direction: column;
    padding: var(--sp-6) clamp(1rem, 4vw, 4rem);
  }

  .auth__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .auth__card {
    width: min(420px, 100%);
    margin: auto;
    padding-block: var(--sp-12);
  }

  .auth h1 {
    font-size: var(--fs-2xl);
  }

  .auth__intro {
    margin: var(--sp-2) 0 var(--sp-8);
    color: var(--ink-2);
  }

  .auth :global(.auth__alt) {
    font-size: var(--fs-sm);
    color: var(--ink-3);
    text-align: center;
  }

  .auth :global(.auth__otp-head) {
    display: flex;
    gap: var(--sp-3);
    align-items: center;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .auth :global(.otp) {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--sp-2);
  }

  .auth :global(.otp__box) {
    padding: 0;
    height: 3.25rem;
    text-align: center;
    font-size: var(--fs-xl);
    font-weight: 700;
  }

  .auth__legal {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    text-align: center;
    padding-bottom: 72px;
  }

  .auth__aside {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: clamp(2rem, 5vw, 5rem);
    overflow: hidden;
    background:
      radial-gradient(60% 60% at 80% 20%, rgb(0 216 206 / 0.28), transparent 70%),
      linear-gradient(150deg, var(--navy-800), var(--navy-950));
    color: rgb(255 255 255 / 0.8);
  }

  .auth__glow {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(70% 70% at 70% 30%, #000, transparent);
  }

  .auth__copy {
    position: relative;
    display: grid;
    gap: var(--sp-5);
    max-width: 460px;
  }

  .auth__copy .eyebrow {
    color: var(--teal-400);
  }

  .auth__quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    color: #fff;
  }

  .auth__copy ul {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
  }

  .auth__copy li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-weight: 550;
  }

  .auth__copy li :global(svg) {
    color: var(--teal-400);
  }

  @media (max-width: 900px) {
    .auth {
      grid-template-columns: 1fr;
    }
    .auth__aside {
      display: none;
    }
  }
</style>
